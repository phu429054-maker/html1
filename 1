local MIN_CFRAME_INTERVAL = 1 / 45
local LastCFrameAt = 0
local MAX_SAFE_SPEED = math.huge

local function jitterVector(magnitude)
    local m = magnitude or 0.15
    return Vector3.new(
        (math.random() - 0.5) * m,
        0,
        (math.random() - 0.5) * m
    )
end

local function safePivot(root, cf)
    if not root or not cf then return end
    local now = os.clock()
    if now - LastCFrameAt < MIN_CFRAME_INTERVAL then return end
    LastCFrameAt = now
    pcall(function() root.CFrame = cf end)
end

local function stripCheatMovers(root)
    if not root then return end
    for _, inst in ipairs(root:GetChildren()) do
        local cls = inst.ClassName
        if cls == "BodyVelocity" or cls == "BodyPosition" or cls == "BodyGyro"
            or cls == "BodyAngularVelocity" or cls == "LinearVelocity"
            or cls == "VectorForce" or cls == "AlignOrientation"
            or cls == "AlignPosition" then
            pcall(function() inst:Destroy() end)
        end
    end
end

local restore = {
    originalHumanoid = nil,
    swappedHumanoid = nil,
    disabledScripts = {},
    pushedMovers = {},
    active = false,
}

local function restoreBody()
    local char = lp.Character
    if not char then restore.active = false; return end

    stripCheatMovers(char:FindFirstChild("HumanoidRootPart"))

    for _, entry in ipairs(restore.disabledScripts) do
        local s = entry.script
        if s and s.Parent then
            pcall(function() s.Disabled = entry.oldDisabled end)
        end
    end
    restore.disabledScripts = {}

    if restore.originalHumanoid and restore.swappedHumanoid then
        local current = char:FindFirstChildOfClass("Humanoid")
        if current == restore.swappedHumanoid then
            pcall(function()
                restore.originalHumanoid.Parent = char
                restore.swappedHumanoid:Destroy()
            end)
            local cam = workspace.CurrentCamera
            if cam then
                pcall(function() cam.CameraSubject = restore.originalHumanoid end)
            end
        end
    end
    restore.originalHumanoid = nil
    restore.swappedHumanoid = nil

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.Sit = false
            hum.PlatformStand = false
            hum.AutoRotate = true
        end)
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function()
            root.AssemblyLinearVelocity  = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    restore.active = false
end

local function swapHumanoid()
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("LocalScript") and string.find(d.Name, "PushBack") then
            table.insert(restore.disabledScripts, { script = d, oldDisabled = d.Disabled })
            pcall(function() d.Disabled = true end)
        end
    end

    local cam = workspace.CurrentCamera
    local camCFrame = cam and cam.CFrame or nil

    local ok, clone = pcall(function()
        hum.Archivable = true
        return hum:Clone()
    end)

    if not ok or not clone then return false end

    restore.originalHumanoid = hum
    restore.swappedHumanoid  = clone
    clone.Parent = char
    RunService.Heartbeat:Wait()
    pcall(function() if hum and hum.Parent then hum:Destroy() end end)

    task.wait(0.1)

    local newHum = char:FindFirstChildOfClass("Humanoid") or clone
    if newHum then
        newHum.Sit = false
        newHum.PlatformStand = false
        newHum.AutoRotate = true
    end

    if cam and newHum then
        pcall(function()
            cam.CameraSubject = newHum
            if camCFrame then cam.CFrame = camCFrame end
        end)
    end

    restore.active = true
    return true
end

local speedOn = false
local speedValue = 100
local speedConns = {}

local function clearSpeedConns()
    for _, c in ipairs(speedConns) do pcall(function() c:Disconnect() end) end
    speedConns = {}
end

local function enableSpeed()
    if not swapHumanoid() then return false end

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return false end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "ApexSpeedBV"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.P = 1250
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.Name = "ApexSpeedBG"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 3000
    bg.D = 50
    bg.CFrame = root.CFrame
    bg.Parent = root

    hum.PlatformStand = true

    table.insert(speedConns, RunService.Heartbeat:Connect(function()
        if not speedOn then return end
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return end
        local bvRef = r:FindFirstChild("ApexSpeedBV")
        local bgRef = r:FindFirstChild("ApexSpeedBG")
        if not bvRef or not bgRef then return end

        local cam = workspace.CurrentCamera
        if not cam then return end

        local moveDir = Vector3.zero
        local humRef = c:FindFirstChildOfClass("Humanoid")
        if humRef and humRef.MoveDirection.Magnitude > 0.01 then
            moveDir = humRef.MoveDirection.Unit
        end

        if moveDir.Magnitude > 0 then
            local step = moveDir * speedValue
            bvRef.Velocity = step + jitterVector(0.1)
            local flat = Vector3.new(moveDir.X, 0, moveDir.Z)
            if flat.Magnitude > 0.001 then
                bgRef.CFrame = CFrame.lookAt(r.Position, r.Position + flat.Unit)
            end
        else
            bvRef.Velocity = Vector3.zero
        end
    end))

    return true
end

local function disableSpeed()
    speedOn = false
    clearSpeedConns()
    restoreBody()
end

