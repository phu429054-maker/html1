        BackgroundColor3 = on and COLORS.good or COLORS.stroke
    }):Play()
    btn.Text = on and "ON" or "OFF"
end

btn.MouseButton1Click:Connect(function()
    local n = tonumber(speedBox.Text)
    if n then
        speedValue = math.clamp(n, 16, MAX_SAFE_SPEED)
        speedBox.Text = tostring(speedValue)
    end

    if not speedOn then
        if enableSpeed() then
            speedOn = true
            setVisual(true)
        end
    else
        disableSpeed()
        setVisual(false)
    end
end)

