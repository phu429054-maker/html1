-- SMOOTH CONTINUOUS MOVING RGB WAVE

local waveGradients = {
	titleGradient,
	borderGradient,
	sendGradient,
	accentGradient,
	iconGradient
}

local waveSpeed = 0.10
local waveConnection

waveConnection = RunService.RenderStepped:Connect(function()
	if not alive or not gui.Parent then
		if waveConnection then
			waveConnection:Disconnect()
		end
		return
	end

	local t = os.clock() * waveSpeed

	for index, targetGradient in ipairs(waveGradients) do
		if targetGradient and targetGradient.Parent then
			local phase = (t + (index - 1) * 0.12) % 1

			targetGradient.Color = ColorSequence.new({
				cp(0, Color3.fromHSV((phase + 0.00) % 1, 1, 1)),
				cp(0.25, Color3.fromHSV((phase + 0.25) % 1, 1, 1)),
				cp(0.50, Color3.fromHSV((phase + 0.50) % 1, 1, 1)),
				cp(0.75, Color3.fromHSV((phase + 0.75) % 1, 1, 1)),
				cp(1, Color3.fromHSV((phase + 1.00) % 1, 1, 1))
			})

			-- Gerakan gelombang yang berterusan
			targetGradient.Offset = Vector2.new(
				math.sin(t * 0.7 + index) * 0.4,
				0
			)
		end
	end
end)

table.insert(connections, waveConnection)

