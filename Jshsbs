-- BUTTON PRESS ANIMATION

local function pressAnimation(button)
	if not alive or not button or not button.Parent then return end

	local originalSize = button.Size

	tween(button, 0.08, {
		Size = UDim2.new(
			originalSize.X.Scale,
			originalSize.X.Offset - 2,
			originalSize.Y.Scale,
			originalSize.Y.Offset - 1
		)
	}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	task.delay(0.1, function()
		if alive and button.Parent then
			tween(button, 0.18, {
				Size = originalSize
			}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		end
	end)
end

-- ORIGINAL LOCAL SYSTEM MESSAGE BEHAVIOR

local function sendMessage()
	if not alive or busy then return end

	local message = box.Text:match("^%s*(.-)%s*$")

	if message == "" then
		tween(inputStroke, 0.15, {
			Color = Color3.fromRGB(255, 85, 125)
		})

		task.delay(0.4, function()
			if alive and inputStroke.Parent then
				tween(inputStroke, 0.25, {
					Color = Color3.fromRGB(100, 85, 135)
				})
			end
		end)

		return
	end

	pressAnimation(send)

	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		box.PlaceholderText = "Game uses Legacy Chat"
		return
	end

	local channels = TextChatService:FindFirstChild("TextChannels")
	local general = channels and channels:FindFirstChild("RBXGeneral")

	if not general then
		box.PlaceholderText = "RBXGeneral not found"
		return
	end

	busy = true

	local success = pcall(function()
		general:DisplaySystemMessage(
			player.DisplayName ..": ".. message
		)
	end)

	if success then
		box.Text = ""
		send.Text = "MESSAGE SENT  ✓"

		tween(sendStroke, 0.2, {
			Color = Color3.fromRGB(100, 255, 180),
			Transparency = 0.05
		})
	else
		send.Text = "FAILED"
		box.PlaceholderText = "Could not display message"
	end

	task.delay(0.9, function()
		if alive and send.Parent then
			send.Text = "SEND TO CHAT     ›"

			tween(sendStroke, 0.25, {
				Color = Color3.fromRGB(255, 145, 195),
				Transparency = 0.5
			})
		end

		busy = false
	end)
end

connect(send.Activated, function()
	if not alive then return end
	sendMessage()
end)

connect(box.FocusLost, function(enterPressed)
	if enterPressed then
		sendMessage()
	end
end)

-- SMOOTH DRAG: MOUSE + TOUCH

local dragging = false
local dragStart
local startPosition
local targetPosition
local activeTouch

connect(title.InputBegan, function(input)
	if not alive then return end

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position
		targetPosition = frame.Position

		if input.UserInputType == Enum.UserInputType.Touch then
			activeTouch = input
		else
			activeTouch = nil
		end
	end
end)

connect(UserInputService.InputChanged, function(input)
	if not alive or not dragging then return end

	local isMouse =
		input.UserInputType == Enum.UserInputType.MouseMovement

	local isTouch =
		activeTouch ~= nil and input == activeTouch

	if isMouse or isTouch then
		local delta = input.Position - dragStart

		targetPosition = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
		activeTouch = nil
	elseif activeTouch and input == activeTouch then
		dragging = false
		activeTouch = nil
	end
end)

connect(RunService.RenderStepped, function(dt)
	if not alive or not frame.Parent then return end

	if dragging and targetPosition then
		local alpha = 1 - math.exp(-22 * dt)
		frame.Position = frame.Position:Lerp(targetPosition, alpha)
	end

	if glow.Parent then
		glow.Position = frame.Position
	end
end)

-- CLOSE

connect(close.Activated, function()
	if closing or not alive then return end

	closing = true
	alive = false
	dragging = false

	tween(frame, 0.27, {
		Size = UDim2.fromOffset(255, 160),
		BackgroundTransparency = 1
	}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

	tween(glow, 0.27, {
		Size = UDim2.fromOffset(260, 170),
		BackgroundTransparency = 1
	})

	tween(border, 0.2, { Transparency = 1 })
	tween(glowStroke, 0.2, { Transparency = 1 })

	for _, obj in ipairs(frame:GetDescendants()) do
		if obj:IsA("TextLabel")
			or obj:IsA("TextButton")
			or obj:IsA("TextBox") then

			tween(obj, 0.18, {
				TextTransparency = 1,
				BackgroundTransparency = 1
			})
		elseif obj:IsA("UIStroke") then
			tween(obj, 0.18, { Transparency = 1 })
		elseif obj:IsA("Frame") then
			tween(obj, 0.18, { BackgroundTransparency = 1 })
		end
	end

	task.wait(0.3)

	for _, connection in ipairs(connections) do
		if connection.Connected then
			connection:Disconnect()
		end
	end

	for _, animation in ipairs(animations) do
		pcall(function()
			animation:Cancel()
		end)
	end

	if gui.Parent then
		gui:Destroy()
	end
end)

